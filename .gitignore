# Python build artefacts
dist/
build/
*.egg-info/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.tox/
.coverage
htmlcov/

# Rust build artefacts (maturin / cargo). Cargo.lock is tracked: the
# extension is an application-like artefact (wheels, sdist), built with the
# dependency versions that were tested.
target/

# Compiled native extension copied into the package by `maturin develop`
python/invisensing/*.so
python/invisensing/*.pyd

# IDE / editor
.vscode/
.idea/
*.swp

# Test outputs
tests/output/

# Generated docs
Docs/*
site/

# Internal release runbook — kept locally for the maintainer, never pushed
PUBLISHING.md
